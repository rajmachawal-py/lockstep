# Lockstep Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth Setup:
# Google OAuth is handled by Supabase Auth (PKCE flow).
# 1. In Google Cloud Console: Create OAuth 2.0 Web Client.
#    Authorized Redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
# 2. In Supabase Dashboard: Navigate to Authentication > Providers > Google,
#    enable Google provider and paste Client ID + Client Secret.
